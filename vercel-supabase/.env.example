# ---------- Your PostgreSQL database (local now, your OCI server later) ----------
# Use the owner of the database (for example the "postgres" user). Create the database first, then run: npm run migrate
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@127.0.0.1:5432/mannu_academy
# Set to 1 if your database requires SSL (many managed databases do)
DATABASE_SSL=0

# ---------- Sign-in ----------
# Any long random text (at least 32 characters). Changing it signs everyone out.
JWT_SECRET=

# ---------- This app's public address ----------
# Used for the Google sign-in redirect and for the link Instagram fetches the clip from, so Instagram must be able to reach it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Where recordings and clips are kept on this server's disk ----------
STORAGE_DIR=./storage

# ---------- Video pipeline worker ----------
# The app checks for work every minute by itself. Set to 0 to switch that off (for example on a second copy of the app).
PIPELINE_WORKER=1
# Optional: lets an outside scheduler or you trigger a run:  curl -H "Authorization: Bearer <CRON_SECRET>" "<site>/api/pipeline/tick?wait=1"
CRON_SECRET=

# ---------- YouTube (Google Cloud -> APIs & Services -> Credentials -> OAuth client, type "Web application") ----------
# Authorised redirect URI:  <NEXT_PUBLIC_SITE_URL>/api/integrations/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Zoom cloud recordings (optional) ----------
# Server-to-Server OAuth app with scope  cloud_recording:read:admin ; webhook event  recording.completed
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
