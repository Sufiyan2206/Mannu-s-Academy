# ---------- Shared ----------
ACADEMY_NAME=Mannu’s Tuition Academy
ACADEMY_TZ=Asia/Dubai
DEFAULT_CURRENCY=AED
# Long random value. The Flask API and the Node service must use the SAME one (they share sign-in).
JWT_SECRET=
# First start only: the administrator account that is created if there are no users yet
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=

# ---------- MySQL ----------
MYSQL_DATABASE=mannus
MYSQL_USER=mannus
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Flask (SQLAlchemy + PyMySQL)
DATABASE_URL=mysql+pymysql://mannus:CHANGE_ME@mysql:3306/mannus?charset=utf8mb4
# Node (mysql2)
DATABASE_URL_NODE=mysql://mannus:CHANGE_ME@mysql:3306/mannus

# ---------- Attendance ----------
ATTENDANCE_MIN_PERCENT=50
LATE_AFTER_MINUTES=10

# ---------- Zoom (optional; without it you paste a meeting link when scheduling) ----------
# Zoom Marketplace -> Build App -> Server-to-Server OAuth. Scopes: meeting:write:admin, report:read:admin
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_EMAIL=

# ---------- Parent monthly report ----------
REPORT_CLASSES_PER_MONTH=12
REPORT_MONTHLY_FEE=250
# Shown at the bottom of the report, e.g. "Tel: +971 50 000 0000 · info@yourdomain.com"
ACADEMY_CONTACT=

# ---------- Later stages (not used yet) ----------
# Stage 3: WhatsApp, YouTube, automatic sending of the parent report.  Stage 4: Instagram Reels, ffmpeg.
